# 로컬 실행에 필요한 환경 변수 목록이다. 값은 비워 두고 커밋한다.
# 복사해서 .env를 만들고 값을 채운다(.env는 커밋하지 않는다).
# 운영 값은 AWS SSM Parameter Store(/moewadeul/prod/*)에 있다.

# 공공데이터포털 인증키 (고캠핑, 기상청 단기·중기예보, 천문연 출몰시각 공용). Decoding 키를 넣는다.
PUBLICDATA_SERVICE_KEY=

# 카카오맵 JavaScript 키. 이 키는 브라우저에 노출된다. 그래서 카카오 콘솔의 JavaScript SDK 도메인으로 보호한다.
# 프론트엔드(Vite)가 읽으므로 VITE_ 접두사가 필요하다. 로컬에서 지도를 보려면 카카오 앱의 웹 플랫폼 도메인에 http://localhost:5173을 등록한다.
VITE_KAKAO_JS_KEY=

# 메일 발송 SMTP (Gmail). 비밀번호는 계정 비밀번호가 아니라, 2단계 인증을 켠 계정에서 발급한 앱 비밀번호다.
# 받는 사람에게 보이는 발신자 이름은 MAIL_FROM_NAME으로 바꿀 수 있다(기본값 뫼와들).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# 로컬 MySQL. docker compose와 local 프로필 앱이 이 값을 함께 읽는다.
# 개발자가 로컬에서만 쓸 비밀번호를 직접 정해 .env에 넣는다(예시 파일에는 비워 둔다). 운영 값은 Parameter Store에 있다.
DB_NAME=moewadeul
DB_USERNAME=moewadeul
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PORT=3306

# 메일 안의 링크에 쓰는 프론트엔드 주소(비밀값이 아니다). 값을 비워 두면 기본값이 아니라 빈 문자열이 되어 링크가 깨지므로, 로컬 개발용 주소를 채워 둔다.
# 운영에서는 서비스 주소로 바꾼다.
WEB_BASE_URL=http://localhost:5173

# CI(본인확인기관의 고유 식별값)를 해시하는 HMAC 비밀 키. 32바이트 이상이어야 하고, 비어 있으면 앱이 시작하지 않는다.
# 로컬에서는 `openssl rand -base64 32`로 만든 값을 넣는다. 키가 바뀌면 저장된 CI 해시와 맞지 않으므로 운영 키는 바꾸지 않는다.
CI_HMAC_KEY=

# 가짜 본인확인 공급자를 켤지 정한다(기본 true). false로 두면 본인확인 요청이 503 "지금은 본인확인을 할 수 없어요."로 끝나고 앱은 그대로 뜬다.
IDENTITY_FAKE_PROVIDER_ENABLED=true

# 인증 코드와 비밀번호 재설정 토큰을 만드는 HMAC 비밀 키. 메일 서버 장애로 같은 메일을 다시 보낼 때 같은 코드와 링크를 보내려고 쓴다.
# 32바이트 이상이어야 하고, 비어 있으면 앱이 시작하지 않는다. 로컬에서는 `openssl rand -base64 32`로 만든 값을 넣는다. CI_HMAC_KEY와 다른 값을 쓴다.
MAIL_SECRET_HMAC_KEY=

# AI 검색이 문장을 해석할 때 쓰는 OpenAI 키. 비워 두면 앱은 뜨지만 AI 검색만 동작하지 않는다.
OPENAI_API_KEY=

# 커뮤니티 글·후기·추억 사진을 둘 저장소(fake 또는 s3, 기본 fake). fake는 실제로 올리지 않는다.
# s3로 두면 UPLOAD_BUCKET에 버킷 이름을 채우고, AWS 자격 증명이 있어야 한다. 운영은 prod 프로필이 s3로 정한다.
IMAGE_STORAGE=fake

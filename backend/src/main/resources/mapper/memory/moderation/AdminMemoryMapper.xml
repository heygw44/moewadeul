<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moewadeul.memory.infra.moderation.AdminMemoryMapper">

    <select id="selectMemories" resultType="com.moewadeul.memory.infra.moderation.AdminMemoryRow">
        SELECT r.id AS memory_id,
               r.member_id AS author_id,
               m.nickname AS author_nickname,
               r.latitude AS latitude,
               r.longitude AS longitude,
               r.visited_date AS visited_date,
               r.nights AS nights,
               r.content AS content,
               r.status AS status,
               (SELECT COUNT(*) FROM memory_report mr
                WHERE mr.memory_id = r.id AND mr.reviewed_at IS NULL) AS report_count,
               r.updated_at AS status_changed_at
        FROM memory r
        JOIN member m ON m.id = r.member_id
        WHERE r.status = #{status}
          AND r.visibility = 'PUBLIC'
        <choose>
            <when test="status.name() == 'HIDDEN'">
                ORDER BY r.updated_at DESC, r.id DESC
            </when>
            <otherwise>
                ORDER BY EXISTS (SELECT 1 FROM memory_report mr
                        WHERE mr.memory_id = r.id AND mr.reviewed_at IS NULL
                          AND mr.reason = 'MONEY_SCAM') DESC, r.updated_at ASC, r.id ASC
            </otherwise>
        </choose>
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectReasonCountsOfNonEmpty" resultType="com.moewadeul.common.moderation.ReportReasonCount">
        <include refid="com.moewadeul.common.moderation.ModerationReportSql.reasonCounts">
            <property name="reportTable" value="memory_report"/>
            <property name="targetColumn" value="memory_id"/>
            <property name="targetScope" value="com.moewadeul.common.moderation.ModerationReportSql.anyTarget"/>
        </include>
    </select>

    <select id="selectRecentReportsOfNonEmpty" resultType="com.moewadeul.common.moderation.RecentReportRow">
        <include refid="com.moewadeul.common.moderation.ModerationReportSql.recentReports">
            <property name="reportTable" value="memory_report"/>
            <property name="targetColumn" value="memory_id"/>
            <property name="targetScope" value="com.moewadeul.common.moderation.ModerationReportSql.anyTarget"/>
        </include>
    </select>

</mapper>

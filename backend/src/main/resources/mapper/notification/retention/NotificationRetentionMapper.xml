<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moewadeul.notification.infra.retention.NotificationRetentionMapper">

    <sql id="expiredRead">
        read_at &lt; #{cutoff}
          AND email_status &lt;&gt; 'PENDING'
    </sql>

    <select id="selectExpiredReadIds" resultType="long">
        SELECT id
        FROM notification
        WHERE <include refid="expiredRead"/>
        ORDER BY read_at
        LIMIT #{limit}
    </select>

    <delete id="deleteExpiredRead">
        DELETE FROM notification
        WHERE id IN
          <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
          AND <include refid="expiredRead"/>
    </delete>
</mapper>

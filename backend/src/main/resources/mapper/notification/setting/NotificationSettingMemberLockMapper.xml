<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moewadeul.notification.infra.setting.NotificationSettingMemberLockMapper">

    <select id="lockMember" resultType="long">
        SELECT id
        FROM member
        WHERE id = #{memberId}
        FOR UPDATE
    </select>
</mapper>

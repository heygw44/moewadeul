<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moewadeul.common.probe.ProbeSql">
    <sql id="selectAll">
        SELECT id
        FROM ${table}
    </sql>
    <sql id="selectAllQuoted">
        SELECT id
        FROM `${table}`
    </sql>
    <sql id="deleteById">
        DELETE FROM ${table}
        WHERE id = #{id}
    </sql>
</mapper>

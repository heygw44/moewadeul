# 운영 Caddy 설정이다. 도메인 하나로 프론트엔드와 API를 함께 내보내서, 브라우저 입장에서 같은 출처가 되게 한다.
# 그래서 CORS를 열지 않고, 세션 쿠키를 SameSite=Lax로 쓸 수 있다.
# Caddy는 SITE_ADDRESS 도메인의 Let's Encrypt 인증서를 자동으로 받고 갱신하며, 80번 포트 요청을 HTTPS로 넘긴다.

{$SITE_ADDRESS} {
	encode zstd gzip

	# API만 앱으로 넘긴다. /actuator는 넘기지 않으므로 상태 확인 주소가 밖으로 드러나지 않는다.
	# Caddy는 클라이언트가 보낸 X-Forwarded-For를 버리고 실제 접속 IP로 새로 채운다. 그래서 앱은 이 헤더를 믿어도 된다.
	# 앱이 다시 뜨는 동안 앱에 연결하지 못한 요청은 메서드와 상관없이 lb_try_duration 동안 다시 보낸다.
	# 연결된 뒤에 실패한 요청은 GET만 다시 보낸다(lb_retry_match 기본값). 그래서 POST가 두 번 처리되지 않는다.
	handle /api/* {
		reverse_proxy app:8080 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}

	handle {
		root * /srv/current
		# Vite는 파일 이름에 내용 해시를 붙인다. 그래서 assets 아래 파일은 브라우저가 오래 저장해도 된다.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# 나머지(index.html과, 화면 경로가 대신 받는 index.html)는 브라우저가 매번 서버에 바뀌었는지 묻게 한다.
		# Cache-Control이 없으면 브라우저가 Last-Modified를 근거로 index.html을 스스로 캐시해서, 배포한 뒤에도 예전 번들을 계속 쓴다.
		# header는 try_files가 경로를 바꾸기 전의 요청 경로로 매칭하므로, /spots/1 같은 화면 경로에도 붙는다.
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"

		# index.html과 정적 파일은 Caddy가 직접 내보내므로, 앱이 /api 응답에 붙이는 보안 헤더가 여기에는 붙지 않는다. 그래서 여기서 붙인다.
		# X-Frame-Options와 frame-ancestors는 다른 사이트가 이 화면을 iframe에 넣지 못하게 한다(클릭재킹 방지).
		# 나머지 지시어는 나중에 XSS가 생겨도 외부 스크립트를 불러오거나 데이터를 밖으로 보내지 못하게 막는다.
		# 외부에서 받는 것은 카카오 지도 SDK와 S3의 사진(보기·올리기)뿐이다. 카카오 쪽 주소는 지도 화면을 실제 브라우저로 열어 확인했다.
		# - 스크립트: dapi.kakao.com이 sdk.js를 주고, sdk.js가 t1.kakaocdn.net에서 본체와 검색 라이브러리를 받는다.
		# - 지도 타일과 아이콘 이미지: mts.kakaocdn.net, t1.kakaocdn.net
		# - style-src의 'unsafe-inline': 카카오 지도 SDK가 요소에 style 속성을 직접 써서, 막으면 브라우저가 위반으로 보고한다.
		# - script-src에 'unsafe-eval'은 넣지 않는다. SDK가 eval을 한 번 부르지만 막아도 지도, 지형 겹치기, 지역 검색이 모두 동작한다.
		#   그래서 브라우저 콘솔에 위반 오류가 하나 남지만 무시해도 된다.
		# - S3 사진은 사전 서명 주소(https://{버킷}.s3.ap-northeast-2.amazonaws.com/...)로 읽고 올린다.
		header X-Frame-Options "DENY"
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://dapi.kakao.com https://*.kakaocdn.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.kakaocdn.net https://*.s3.ap-northeast-2.amazonaws.com; connect-src 'self' https://dapi.kakao.com https://*.s3.ap-northeast-2.amazonaws.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# /assets/* 는 파일이 없으면 404로 끝낸다. 배포 뒤 옛 탭이 사라진 화면 코드 파일을 요청할 때 index.html(HTML)을 JS 자리에 200으로 주면,
		# 브라우저가 그것을 1년 캐시할 수 있고 화면도 원인을 알 수 없게 깨진다. 404여야 화면이 새로고침으로 복구한다.
		handle /assets/* {
			file_server
		}
		# 화면 경로(/spots/1 등)는 파일이 없으므로 index.html을 주고, 라우팅은 프론트엔드가 한다.
		handle {
			try_files {path} /index.html
			file_server
		}
	}

	header {
		# 브라우저가 이 도메인에는 HTTPS로만 접속하게 한다. duckdns.org의 다른 하위 도메인에는 적용하지 않는다.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# /assets/* 의 오류(없는 파일의 404 등)는 위의 1년 캐시 헤더를 그대로 달고 나간다. 브라우저가 오류를 1년 저장하지 않게 덮어쓴다.
	# 그 밖의 오류(앱이 죽었을 때의 502 등)는 지금처럼 Caddy 기본 응답으로 둔다.
	handle_errors {
		@assets path /assets/*
		handle @assets {
			header Cache-Control "no-store"
			respond "{err.status_code} {err.status_text}"
		}
	}
}

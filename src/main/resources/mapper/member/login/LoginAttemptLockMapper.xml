<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moewadeul.member.infra.login.LoginAttemptLockMapper">

    <!--
        INSERT IGNORE 대신 ON DUPLICATE KEY UPDATE를 쓴다. 행이 이미 있으면 INSERT IGNORE는 그 행에 공유 잠금만 얻는다.
        그 뒤 같은 트랜잭션이 쓰기 잠금으로 올리려 할 때 같은 키의 다른 요청도 공유 잠금을 쥐고 있으면 서로 기다리다 교착이 난다.
        이 문장은 행이 이미 있어도 처음부터 쓰기 잠금을 얻는다.
    -->
    <insert id="lock">
        INSERT INTO login_attempt_lock (attempt_key, last_attempt_at)
        VALUES (#{key}, #{now})
        ON DUPLICATE KEY UPDATE last_attempt_at = #{now}
    </insert>

    <delete id="deleteIdleBefore">
        DELETE FROM login_attempt_lock
        WHERE last_attempt_at &lt; #{cutoff}
        LIMIT #{limit}
    </delete>
</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moewadeul.memory.infra.image.MemoryImageMapper">

    <select id="selectByNonEmptyMemoryIds" resultType="com.moewadeul.memory.infra.image.MemoryImageRow">
        SELECT id AS image_id, memory_id, object_key
        FROM memory_image
        WHERE memory_id IN
        <foreach collection="memoryIds" item="memoryId" open="(" separator="," close=")">#{memoryId}</foreach>
        ORDER BY memory_id, display_order
    </select>

    <select id="selectUnattachedCreatedBefore" resultType="com.moewadeul.common.image.infra.UnattachedImageRow">
        <include refid="com.moewadeul.common.image.infra.AttachableImageSql.selectUnattachedCreatedBefore">
            <property name="table" value="memory_image"/>
            <property name="parentColumn" value="memory_id"/>
            <property name="thumbnailColumn" value="thumbnail_object_key"/>
        </include>
    </select>

    <select id="selectUnattachedByMember" resultType="com.moewadeul.common.image.infra.UnattachedImageRow">
        SELECT id AS image_id, object_key, thumbnail_object_key AS thumbnail_key
        FROM memory_image
        WHERE member_id = #{memberId}
          AND memory_id IS NULL
          AND id &gt; #{afterId}
        ORDER BY id
        LIMIT #{limit}
    </select>

    <delete id="deleteIfUnattached">
        <include refid="com.moewadeul.common.image.infra.AttachableImageSql.deleteIfUnattached">
            <property name="table" value="memory_image"/>
            <property name="parentColumn" value="memory_id"/>
        </include>
    </delete>

    <select id="lockMember" resultType="long">
        <include refid="com.moewadeul.common.image.infra.AttachableImageSql.lockMember"/>
    </select>

    <select id="selectUnattachedCreatedAtsAfter" resultType="java.time.Instant">
        <include refid="com.moewadeul.common.image.infra.AttachableImageSql.selectUnattachedCreatedAtsAfter">
            <property name="table" value="memory_image"/>
            <property name="parentColumn" value="memory_id"/>
        </include>
    </select>
</mapper>

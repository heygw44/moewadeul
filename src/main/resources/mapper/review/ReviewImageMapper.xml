<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moewadeul.review.infra.ReviewImageMapper">

    <select id="selectByReviewIds" resultType="com.moewadeul.review.infra.ReviewImageRow">
        SELECT id AS image_id, review_id, object_key
        FROM review_image
        WHERE review_id IN
        <foreach collection="reviewIds" item="reviewId" open="(" separator="," close=")">#{reviewId}</foreach>
        ORDER BY review_id, display_order
    </select>

    <select id="selectUnattachedCreatedBefore" resultType="com.moewadeul.common.image.infra.UnattachedImageRow">
        <include refid="com.moewadeul.common.image.infra.AttachableImageSql.selectUnattachedCreatedBefore">
            <property name="table" value="review_image"/>
            <property name="parentColumn" value="review_id"/>
            <property name="thumbnailColumn" value="NULL"/>
        </include>
    </select>

    <delete id="deleteIfUnattached">
        <include refid="com.moewadeul.common.image.infra.AttachableImageSql.deleteIfUnattached">
            <property name="table" value="review_image"/>
            <property name="parentColumn" value="review_id"/>
        </include>
    </delete>

    <select id="lockMember" resultType="long">
        <include refid="com.moewadeul.common.image.infra.AttachableImageSql.lockMember"/>
    </select>

    <select id="selectUnattachedCreatedAtsAfter" resultType="java.time.Instant">
        <include refid="com.moewadeul.common.image.infra.AttachableImageSql.selectUnattachedCreatedAtsAfter">
            <property name="table" value="review_image"/>
            <property name="parentColumn" value="review_id"/>
        </include>
    </select>
</mapper>

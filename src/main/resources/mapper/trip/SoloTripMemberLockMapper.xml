<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moewadeul.trip.infra.SoloTripMemberLockMapper">

    <!-- 기본 키로 한 행만 잠근다. 행이 늘 있어서 빈 범위 잠금이 생기지 않는다. -->
    <select id="lockMember" resultType="long">
        SELECT id
        FROM member
        WHERE id = #{memberId}
        FOR UPDATE
    </select>
</mapper>

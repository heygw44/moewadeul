<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moewadeul.trust.infra.companion.CompanionReviewSql">

    <sql id="reverseWritten">
        EXISTS (SELECT 1 FROM companion_review rv
                WHERE rv.basecamp_id = r.basecamp_id AND rv.reviewer_id = r.reviewee_id
                  AND rv.reviewee_id = r.reviewer_id)
    </sql>

    <!-- CompanionReviewPolicy.isRevealed와 같은 규칙이다. 별칭은 r(companion_review)과 b(basecamp)다. -->
    <sql id="revealed">
        (b.completed_at &lt; #{revealCutoff}
            OR <include refid="com.moewadeul.trust.infra.companion.CompanionReviewSql.reverseWritten"/>)
    </sql>

</mapper>
